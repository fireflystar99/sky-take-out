# 编译后的字节码文件（Java 编译生成，不需要提交）
*.class

# 日志文件（运行时生成，不需要提交）
*.log

# BlueJ 编辑器生成的文件
*.ctxt

# J2ME 移动开发临时文件
.mtj.tmp/

# 打包文件、压缩包（构建产物，不需要提交）
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM 崩溃日志
hs_err_pid*
replay_pid*

# Maven / Gradle 构建输出目录（核心！必须忽略）
**/target/
**/build/

# IntelliJ IDEA 编辑器配置文件（每个人电脑不同，不共享）
*.iml
*.iws
*.ipr
.idea/

# Eclipse 编辑器配置文件
.classpath
.project
.settings/

# 测试文件、测试目录（项目里明确要忽略测试代码）
*Test.java
**/test/
**/src/test/

# 环境配置文件（包含密码、密钥，绝对不能提交到 Git）
*-env.yml
*.env
.env
.env.*

# 操作系统自动生成的垃圾文件
.DS_Store       # Mac 系统
Thumbs.db       # Windows 系统